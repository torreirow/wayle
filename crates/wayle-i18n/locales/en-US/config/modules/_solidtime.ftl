### Wayle Configuration - Solidtime Module

## Solidtime Module Configuration

settings-modules-solidtime-icon-name = Icon Name
    .description = Symbolic icon name shown in the bar button

settings-modules-solidtime-border-show = Show Border
    .description = Display border around button

settings-modules-solidtime-border-color = Border Color
    .description = Border color token

settings-modules-solidtime-icon-show = Show Icon
    .description = Display module icon

settings-modules-solidtime-icon-color = Icon Color
    .description = Icon foreground color

settings-modules-solidtime-icon-bg-color = Icon Background
    .description = Icon container background color

settings-modules-solidtime-label-show = Show Label
    .description = Display the live timer label

settings-modules-solidtime-label-color = Label Color
    .description = Label text color

settings-modules-solidtime-label-max-length = Label Max Length
    .description = Max characters before truncation

settings-modules-solidtime-button-bg-color = Button Background
    .description = Button background color

settings-modules-solidtime-left-click = Left Click
    .description = Action on left click (default opens solidtime dropdown)

settings-modules-solidtime-right-click = Right Click
    .description = Shell command on right click

settings-modules-solidtime-middle-click = Middle Click
    .description = Shell command on middle click

settings-modules-solidtime-scroll-up = Scroll Up
    .description = Action on scroll up

settings-modules-solidtime-scroll-down = Scroll Down
    .description = Action on scroll down
